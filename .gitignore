# Python bytecode and packaging metadata.
# No trailing slash on __pycache__: the pattern must also match a stray FILE of
# that name, which would stop Python writing its bytecode cache for the package.
__pycache__
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test and tool caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints
.coverage
htmlcov/

# Logs
*.log

# Local settings. mesh_config.json holds NCBI credentials and per-user paths;
# the pipeline falls back to factory defaults when it is absent.
mesh_config.json
mesh_config.json.bak*
.env

# Scratch notebooks
src/mesh_aop_notebooks/test.ipynb
src/mesh_aop_notebooks/test_2.ipynb

# Written by packaging/make_icon.py for inspection. Builds themselves write to
# the location in packaging/build_location.py, outside the project.
packaging/_icon_preview.png

# Generated data and results. The master database alone is over 7 GB, well past
# GitHub's 100 MB file limit. data/reference_processed IS tracked: it ships
# inside every build and the bundled ground truth depends on it.
data/raw/*
!data/raw/.gitkeep
!data/raw/aop_annotations_master.csv
!data/raw/ground_truth_pmids.template.csv
data/processed/*
!data/processed/.gitkeep
data/reference_raw/*
!data/reference_raw/.gitkeep
results/*
!results/.gitkeep
!results/reference_figures/.gitkeep
results_SNAPSHOT_*.zip

# Manuscript drafts
*-draft.md
